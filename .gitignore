# ─── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
*.egg

# ─── Virtual envs ────────────────────────────────────────────────────────
.venv/
venv/
env/

# ─── IDE / OS ────────────────────────────────────────────────────────────
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# ─── Tooling caches ──────────────────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ─── Foliko runtime ──────────────────────────────────────────────────────
.foliko/

# ─── Flybrain local data (~/.flybrain/) ──────────────────────────────────
# Compiled graphs and downloaded datasets are user-specific and big.
# Users get these via `flybrain.connectome.compile.compile_graph()`.
*.npz.lock
*.npz.tmp

# ─── Bench / dev-time probes (openfly-lif-1.3 work) ─────────────────────
# bench_v12/*.npy  : captured state snapshots from bench_v12_capture.py
# scripts/diag*.py : ad-hoc diagnostic probes (one-shot during dev)
# scripts/instr_kernel.py / probe_overhead.py : micro-profilers
bench_v12/*.npy
scripts/diag*.py
scripts/instr_kernel.py
scripts/probe_overhead.py